{
  "name": "@organizard/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply organizard --local",
    "lint": "eslint .",
    "format": "prettier --write src test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "jose": "^5.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/sql.js": "^1.4.9",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "sql.js": "^1.12.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
