{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["@babel/core", "expo-modules-core", "expo-updates", "promise"],
  "ignore": ["components/index.ts", "store/useStore.ts", "store/types.ts", "store/createStore.ts"],
  "workspaces": {
    ".": {
      "entry": ["app/**/*.tsx", "plugins/**", "modules/*/index.ts"],
      "project": [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "features/**/*.{ts,tsx}",
        "hooks/**",
        "lib/**",
        "services/**",
        "store/**",
        "shared/**",
        "theme/**",
        "data/**",
        "plugins/**",
        "modules/*/index.ts"
      ]
    },
    "server": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
