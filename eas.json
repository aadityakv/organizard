{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "production": {
      "credentialsSource": "local",
      "ios": {
        "autoIncrement": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REDACTED-see-local-notes",
        "ascApiKeyPath": "./credentials/asc_api_key.p8",
        "ascApiKeyId": "REDACTED-see-local-notes",
        "ascApiKeyIssuerId": "REDACTED-see-local-notes"
      }
    }
  }
}
