# dependencies
node_modules/
node_modules
**/node_modules

# git worktrees
.worktrees/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by `expo prebuild` — regenerated from app.json, not tracked)
/ios/
/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Apple credentials (App Store Connect API key, certs) — never commit
/credentials/
/credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Claude Code local config
.claude/
