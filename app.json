{
  "expo": {
    "name": "Organizard",
    "slug": "organizard",
    "scheme": "organizard",
    "version": "1.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F6F2",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.organizard.app",
      "buildNumber": "5",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Organizard uses the camera to photograph your items and scan box QR labels.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.organizard.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Organizard uses the camera to photograph your items and scan box QR labels."
        }
      ],
      "./plugins/withFmtConstevalFix",
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://organizard-api.aaditya-kv.workers.dev",
      "revenueCatKey": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0ec495c8-dd4d-4f5b-8ce2-5aad385abad6"
      }
    },
    "owner": "aadityakv"
  }
}
