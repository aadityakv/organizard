{
  "name": "organizard",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "knip": "knip"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.2.3",
    "@expo-google-fonts/nunito": "^0.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.17.1",
    "expo": "^56.0.9",
    "expo-apple-authentication": "~56.0.4",
    "expo-camera": "~56.0.7",
    "expo-constants": "~56.0.17",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.10",
    "expo-linking": "~56.0.13",
    "expo-location": "~56.0.16",
    "expo-print": "~56.0.3",
    "expo-router": "~56.2.9",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.16",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-purchases": "^8.2.1",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/config-plugins": "56.0.8",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
