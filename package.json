{
  "name": "organizard",
  "version": "1.0.0",
  "description": "Tuck: an iOS app for organizing a physical move (Expo + React Native + Zustand).",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/aadityakv/organizard.git"
  },
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "knip": "knip",
    "test:coverage": "vitest run --coverage",
    "test:ui": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.2.3",
    "@expo-google-fonts/nunito": "^0.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.17.1",
    "@sentry/react-native": "~7.11.0",
    "expo": "~56.0.21",
    "expo-apple-authentication": "~56.0.4",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.17",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-linking": "~56.0.17",
    "expo-location": "~56.0.25",
    "expo-modules-core": "~56.0.15",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.20",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^0.468.0",
    "promise": "^8.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-purchases": "^8.2.1",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/config-plugins": "56.0.8",
    "@jest/globals": "^29.7.0",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.14",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
